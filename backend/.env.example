PORT=5000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=syncstream
JWT_SECRET=change_this_to_a_long_random_string

# Optional. Without SMTP, the signup code is written to the server log instead of emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional. Only needed for the AI chatbot.
GROQ_API_KEY=

# Set in production instead of the DB_* values.
# DATABASE_URL=
# CORS_ORIGIN=https://your-frontend.vercel.app

# Optional. Set to share room broadcasts across several server instances (Redis Pub/Sub). Use rediss:// for TLS.
# Leave empty to run a single instance. Example for Upstash:
# REDIS_URL=rediss://default:YOUR_PASSWORD@your-database.upstash.io:6379
REDIS_URL=
